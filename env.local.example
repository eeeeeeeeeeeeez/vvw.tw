# Gemini API 金鑰（必需）
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 管理員認證（改用環境變數而非硬編碼）
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_password_here

# Supabase 設定（如果使用）
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_key

# 後端伺服器設定
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SERVER_PORT=3001

# Google Search API (必需用於聯網搜尋)
# 取得 API Key: https://developers.google.com/custom-search/v1/introduction
# 取得 Search Engine ID (CX): https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# Formspree 設定 (用於表單提交)
# 1. 前往 https://formspree.io/ 註冊
# 2. 建立兩個新表單，設定收件信箱為 tvivl.tw@gmail.com
# 3. 複製每個表單的 Endpoint URL（格式如：https://formspree.io/f/xoypzzzz）
FORMSPREE_CONTACT_URL=https://formspree.io/f/your_contact_form_id
FORMSPREE_NEWSLETTER_URL=https://formspree.io/f/your_newsletter_form_id

# 知識庫發文後台（/admin/blog）
# ADMIN_PASSWORD：後台登入密碼（請設定一組夠長的密碼，只放在後端環境變數，不要加 VITE_ 前綴）
# SUPABASE_SERVICE_ROLE_KEY：上方已有，後台寫入文章需要它
# ADMIN_TOKEN_SECRET：選填，登入憑證的簽章金鑰；沒填就使用 ADMIN_PASSWORD
# SITE_URL：選填，sitemap 使用的網址，預設 https://hengbo.co
ADMIN_PASSWORD=change_me_to_a_long_password
ADMIN_TOKEN_SECRET=
SITE_URL=https://hengbo.co
